    "@tinacms/cli": "^2.4.2",
    "@types/node": "^25.9.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
