---
import { getCollection, render } from "astro:content";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ArticleView from "~/components/ArticleView.astro";
import MdxAnchor from "~/components/mdx/MdxAnchor.astro";
import MdxImage from "~/components/mdx/MdxImage.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const enableVisualEditing = process.env.TINA_ENABLED === "true" || Boolean(process.env.NEXT_PUBLIC_TINA_CLIENT_ID);
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.cover}
>
  {enableVisualEditing ? (
    <TinaIsland name="article" params={{ slug: article.id }} wrapper={{ tag: "div" }} primary>
      <ArticleView article={article.data} slug={article.id}>
        <Content components={{ a: MdxAnchor, img: MdxImage }} />
      </ArticleView>
    </TinaIsland>
  ) : (
    <ArticleView article={article.data} slug={article.id}>
      <Content components={{ a: MdxAnchor, img: MdxImage }} />
    </ArticleView>
  )}
</BaseLayout>
