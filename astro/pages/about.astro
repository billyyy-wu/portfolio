---
import { getEntry } from "astro:content";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import AboutView from "~/components/AboutView.astro";

const aboutEntry = await getEntry("pages", "about");
if (!aboutEntry) throw new Error("Missing about page content: content/pages/about.mdx");
const enableVisualEditing = process.env.TINA_ENABLED === "true" || Boolean(process.env.NEXT_PUBLIC_TINA_CLIENT_ID);
---

<BaseLayout title={aboutEntry.data.title} description={aboutEntry.data.description}>
  {enableVisualEditing ? (
    <TinaIsland name="about" wrapper={{ tag: "div" }} primary>
      <AboutView page={aboutEntry.data} />
    </TinaIsland>
  ) : (
    <AboutView page={aboutEntry.data} />
  )}
</BaseLayout>
