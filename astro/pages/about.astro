---
import BaseLayout from "~/layouts/BaseLayout.astro";

const experienceItems = [
  "Independent art director and designer",
  "Branding, advertising and visual design",
  "Educator and founder of Panka",
];

// About 页面复用首页客户资产，保持品牌信任区与现有视觉系统一致。
const clientLogos = [
  { src: "/logos/logo-carlsberg.svg", width: 96, height: 38, alt: "Carlsberg" },
  { src: "/logos/logo-momkind.svg", width: 133, height: 24, alt: "momkind" },
  { src: "/logos/logo-roskilde-festival.svg", width: 105, height: 40, alt: "Roskilde Festival" },
  { src: "/logos/logo-mobilepay.svg", width: 125, height: 40, alt: "MobilePay" },
];
---

<BaseLayout
  title="About Billy"
  description="About Billy Wu, independent art director, designer, educator and founder of Panka."
>
  <section class="bg-blush pb-16 pt-12 md:pb-[100px] md:pt-[120px]">
    <div class="mx-auto grid w-full max-w-site grid-cols-1 gap-12 px-4 md:grid-cols-[minmax(0,1fr)_360px] md:gap-[92px]">
      <div class="flex flex-col">
        <p
          data-global-reveal-group="section-heading"
          data-reveal-preload="true"
          class="mb-10 font-nav text-[14px] font-medium leading-[14px] tracking-[0] text-neutral-600 md:mb-[60px]"
        >
          About
        </p>
        <h1
          data-global-reveal-group="hero-title"
          data-reveal-preload="true"
          class="max-w-[760px] text-[40px] font-bold leading-[52px] tracking-[-1.6px] text-ink md:text-[72px] md:leading-[86px] md:tracking-[-2.88px]"
        >
          Billy Wu is an independent art director, designer, educator and founder of
          <img
            src="/logo-panka.svg"
            alt="Panka"
            width="178"
            height="56"
            loading="eager"
            decoding="async"
            class="mb-2 ml-2 inline-block h-auto w-[126px] md:mb-3 md:w-[178px]"
          />.
        </h1>
      </div>

      <aside
        data-global-reveal-group="image"
        data-reveal-preload="true"
        class="flex flex-col md:pt-[74px]"
      >
        <div class="aspect-square w-[180px] overflow-hidden rounded-full bg-white md:w-[280px]">
          <img
            src="/billy-avatar.png"
            alt="Billy Wu"
            width="280"
            height="280"
            loading="eager"
            decoding="async"
            class="size-full object-cover"
          />
        </div>
        <ul class="mt-10 space-y-5 font-nav text-[18px] font-medium leading-[26px] tracking-[-0.36px] text-neutral-600 md:mt-[60px] md:text-[20px] md:leading-7 md:tracking-[-0.5px]">
          {experienceItems.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="bg-white py-16 md:py-[100px]">
    <div class="mx-auto grid w-full max-w-site grid-cols-1 gap-12 px-4 md:grid-cols-[270px_minmax(0,1fr)] md:gap-[130px]">
      <div data-global-reveal-group="section-heading">
        <h2 class="font-nav text-[20px] font-medium leading-7 tracking-[-0.5px] text-ink">
          Profile
        </h2>
      </div>
      <div class="max-w-[770px]">
        <p class="text-[24px] font-medium leading-[36px] tracking-[-0.48px] text-neutral-600 md:text-[32px] md:leading-[48px] md:tracking-[-0.64px]">
          With more than 10 years of experience in branding, advertising and visual design,
          Billy works with clients who want to stand out with bold design and clever ideas.
        </p>
        <p class="mt-10 text-[18px] font-medium leading-8 tracking-[-0.36px] text-neutral-600 md:mt-[60px] md:text-[20px] md:leading-[34px] md:tracking-[-0.4px]">
          The practice spans brand systems, campaign identities, editorial concepts and
          digital-first experiences, balancing strategic clarity with expressive visual craft.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white pb-20 md:pb-[120px]">
    <div class="mx-auto grid w-full max-w-site grid-cols-1 gap-12 border-t border-[#d9d9d9] px-4 pt-16 md:grid-cols-[270px_minmax(0,1fr)] md:gap-[130px] md:pt-[80px]">
      <div data-global-reveal-group="section-heading">
        <h2 class="font-nav text-[20px] font-medium leading-7 tracking-[-0.5px] text-ink">
          Selected clients
        </h2>
      </div>
      <ul class="grid grid-cols-2 items-center gap-x-12 gap-y-12 md:grid-cols-4 md:gap-x-[64px]">
        {clientLogos.map((logo) => (
          <li class="flex min-h-14 items-center">
            <img
              src={logo.src}
              alt={logo.alt}
              width={logo.width}
              height={logo.height}
              loading="lazy"
              decoding="async"
              class="max-h-14 w-auto opacity-30"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
