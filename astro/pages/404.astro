---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Article not found" description="The article may have been moved or removed.">
  <section class="mx-auto w-full max-w-site px-4 py-24">
    <h1 class="text-4xl font-black text-ink">Article not found</h1>
    <p class="mt-4 text-lg leading-8 text-neutral-600">
      The article may have been moved or removed.
    </p>
    <a class="mt-8 inline-block font-black text-accent" href="/">
      Back to work
    </a>
  </section>
</BaseLayout>
