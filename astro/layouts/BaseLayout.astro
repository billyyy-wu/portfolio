---
import Footer from "~/components/layout/Footer.astro";
import NavBar from "~/components/layout/NavBar.astro";
import PageScripts from "~/components/PageScripts.astro";
import BackToTopButton from "~/components/ui/BackToTopButton.astro";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Cathrine Understrup | Portfolio",
  description = "Freelance art director and designer portfolio built with Astro, Tailwind CSS, and MDX.",
  image,
} = Astro.props;
const pageTitle = title === "Cathrine Understrup | Portfolio" ? title : `${title} | Portfolio`;
const panelDurations = [0.05, 0.12, 0.12, 0.12, 0.05];
const panelGap = 0.05;
const panelDelays = panelDurations.map((_, index) =>
  panelDurations.slice(0, index).reduce((total, duration) => total + duration + panelGap, 0),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image ? <meta property="og:image" content={image} /> : null}
    <link rel="preload" href="/fonts/gotham-medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <NavBar />
    <main class="flex-1">
      <div class="relative bg-white">
        <slot />
      </div>
    </main>
    <Footer />
    <BackToTopButton />
    <div
      data-route-transition-overlay
      class="route-transition-overlay"
      aria-hidden="true"
    >
      {panelDurations.map((duration, index) => (
        <span
          class="route-transition-panel"
          style={`--route-panel-delay: ${panelDelays[index]}s; --route-panel-duration: ${duration}s;`}
        />
      ))}
    </div>
    <PageScripts />
  </body>
</html>
