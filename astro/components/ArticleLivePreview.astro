---
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";
import type { CustomComponentsMap } from "@tinacms/astro/types";
import ArticleView from "~/components/ArticleView.astro";
import MdxAnchor from "~/components/mdx/MdxAnchor.astro";
import MdxImage from "~/components/mdx/MdxImage.astro";
import type { TinaArticle } from "~/lib/tina-preview";

interface Props {
  article: TinaArticle;
  slug: string;
}

const { article, slug } = Astro.props;
const components: CustomComponentsMap = { a: MdxAnchor, img: MdxImage };
---

<ArticleView article={article} slug={slug}>
  <TinaMarkdown content={article.body} components={components} />
</ArticleView>
