---
import { existsSync, readFileSync } from "node:fs";
import path from "node:path";

type ImageSize = { width: number; height: number };

const imageSizeCache = new Map<string, ImageSize | undefined>();

const priorityImageSources = new Set([
  "/images/ai-design-workflow.svg",
  "/images/design-trends-2026.svg",
  "/images/prompt-library.svg",
]);

function readUint24LE(buffer: Buffer, offset: number) {
  return buffer[offset] | (buffer[offset + 1] << 8) | (buffer[offset + 2] << 16);
}

function readPngSize(buffer: Buffer): ImageSize | undefined {
  if (buffer.length < 24 || buffer.toString("ascii", 1, 4) !== "PNG") {
    return undefined;
  }

  return {
    width: buffer.readUInt32BE(16),
    height: buffer.readUInt32BE(20),
  };
}

function readJpegSize(buffer: Buffer): ImageSize | undefined {
  let offset = 2;

  while (offset < buffer.length) {
    if (buffer[offset] !== 0xff) {
      return undefined;
    }

    const marker = buffer[offset + 1];
    const length = buffer.readUInt16BE(offset + 2);

    if (marker >= 0xc0 && marker <= 0xc3) {
      return {
        height: buffer.readUInt16BE(offset + 5),
        width: buffer.readUInt16BE(offset + 7),
      };
    }

    offset += 2 + length;
  }

  return undefined;
}

function readWebpSize(buffer: Buffer): ImageSize | undefined {
  if (
    buffer.length < 30 ||
    buffer.toString("ascii", 0, 4) !== "RIFF" ||
    buffer.toString("ascii", 8, 12) !== "WEBP"
  ) {
    return undefined;
  }

  const chunkType = buffer.toString("ascii", 12, 16);

  if (chunkType === "VP8X") {
    return {
      width: readUint24LE(buffer, 24) + 1,
      height: readUint24LE(buffer, 27) + 1,
    };
  }

  if (chunkType === "VP8 ") {
    return {
      width: buffer.readUInt16LE(26) & 0x3fff,
      height: buffer.readUInt16LE(28) & 0x3fff,
    };
  }

  if (chunkType === "VP8L") {
    const b0 = buffer[21];
    const b1 = buffer[22];
    const b2 = buffer[23];
    const b3 = buffer[24];

    return {
      width: 1 + (((b1 & 0x3f) << 8) | b0),
      height: 1 + (((b3 & 0x0f) << 10) | (b2 << 2) | ((b1 & 0xc0) >> 6)),
    };
  }

  return undefined;
}

function readSvgSize(content: string): ImageSize | undefined {
  const widthMatch = content.match(/\bwidth="([\d.]+)"/);
  const heightMatch = content.match(/\bheight="([\d.]+)"/);

  if (widthMatch && heightMatch) {
    return {
      width: Math.round(Number(widthMatch[1])),
      height: Math.round(Number(heightMatch[1])),
    };
  }

  const viewBoxMatch = content.match(/\bviewBox="[\d.\s-]+ ([\d.]+) ([\d.]+)"/);

  if (!viewBoxMatch) {
    return undefined;
  }

  return {
    width: Math.round(Number(viewBoxMatch[1])),
    height: Math.round(Number(viewBoxMatch[2])),
  };
}

function readPublicImageSize(src: string): ImageSize | undefined {
  const pathname = src.split(/[?#]/)[0];

  if (!pathname.startsWith("/")) {
    return undefined;
  }

  if (imageSizeCache.has(pathname)) {
    return imageSizeCache.get(pathname);
  }

  try {
    const filePath = path.join(process.cwd(), "public", decodeURIComponent(pathname));

    if (!existsSync(filePath)) {
      imageSizeCache.set(pathname, undefined);
      return undefined;
    }

    const extension = path.extname(pathname).toLowerCase();
    const buffer = readFileSync(filePath);
    let imageSize: ImageSize | undefined;

    // 构建时自动补齐图片宽高，避免手写尺寸表和内容图片脱节。
    if (extension === ".png") {
      imageSize = readPngSize(buffer);
    } else if (extension === ".jpg" || extension === ".jpeg") {
      imageSize = readJpegSize(buffer);
    } else if (extension === ".webp") {
      imageSize = readWebpSize(buffer);
    } else if (extension === ".svg") {
      imageSize = readSvgSize(buffer.toString("utf8"));
    }

    imageSizeCache.set(pathname, imageSize);
    return imageSize;
  } catch {
    imageSizeCache.set(pathname, undefined);
    return undefined;
  }
}

const { class: className, src, alt = "", ...attrs } = Astro.props;
const imageSize = typeof src === "string" ? readPublicImageSize(src) : undefined;
const isPriorityImage = typeof src === "string" && priorityImageSources.has(src);
const loading = attrs.loading ?? (isPriorityImage ? "eager" : "lazy");
const fetchPriority = attrs.fetchpriority ?? (isPriorityImage ? "high" : undefined);
---

<span
  data-global-reveal-group="media-image"
  class="article-body__figure overflow-hidden bg-white"
>
  <img
    {...attrs}
    src={src}
    alt={alt}
    width={attrs.width ?? imageSize?.width}
    height={attrs.height ?? imageSize?.height}
    loading={loading}
    fetchpriority={fetchPriority}
    decoding="async"
    class:list={["block h-auto w-full object-contain", className]}
  />
</span>
