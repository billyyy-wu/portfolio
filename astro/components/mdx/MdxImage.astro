---
const knownImageSizes: Record<string, { width: number; height: number }> = {
  "/images/ai-design-workflow.svg": { width: 1200, height: 860 },
  "/images/design-trends-2026.svg": { width: 1200, height: 860 },
  "/images/prompt-library.svg": { width: 1200, height: 860 },
};

const { class: className, src, alt = "", ...attrs } = Astro.props;
const imageSize = typeof src === "string" ? knownImageSizes[src] : undefined;
const loading = attrs.loading ?? (imageSize ? "eager" : "lazy");
const fetchPriority = attrs.fetchpriority ?? (imageSize ? "high" : undefined);
---

<span
  data-global-reveal-group="media-image"
  class="article-body__figure overflow-hidden bg-white"
>
  <img
    {...attrs}
    src={src}
    alt={alt}
    width={attrs.width ?? imageSize?.width}
    height={attrs.height ?? imageSize?.height}
    loading={loading}
    fetchpriority={fetchPriority}
    decoding="async"
    class:list={["block h-auto w-full object-contain", className]}
  />
</span>
