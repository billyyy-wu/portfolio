{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "~/*": [
        "./astro/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "astro/env.d.ts",
    "astro/**/*.ts",
    "astro.config.mjs",
    "scripts/**/*.mjs",
    "tailwind.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
